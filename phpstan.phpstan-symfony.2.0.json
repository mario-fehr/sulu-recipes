{
    "manifests": {
        "phpstan/phpstan-symfony": {
            "manifest": {
                "copy-from-recipe": {
                    "tests/": "tests/"
                },
                "add-lines": [
                    {
                        "file": "phpstan.dist.neon",
                        "position": "after_target",
                        "target": "    level: max",
                        "content": "    doctrine:\n        objectManagerLoader: tests/phpstan/object-manager.php\n    symfony:\n        containerXmlPath: %currentWorkingDirectory%/var/cache/website/dev/App_KernelDevDebugContainer.xml\n        consoleApplicationLoader: tests/phpstan/console-application.php",
                        "requires": [
                            "phpstan/phpstan",
                            "phpstan/phpstan-doctrine:>=2.0",
                            "phpstan/phpstan-symfony:>=2.0",
                            "phpstan/extension-installer"
                        ]
                    },
                    {
                        "file": "rector.php",
                        "position": "after_target",
                        "target": "    ->withRootFiles()",
                        "content": "    ->withPHPStanConfigs([\n        __DIR__ . '/phpstan.dist.neon',\n        // rector does not load phpstan extension automatically so require them manually here:\n        __DIR__ . '/vendor/phpstan/phpstan-doctrine/extension.neon',\n        __DIR__ . '/vendor/phpstan/phpstan-symfony/extension.neon',\n    ])",
                        "requires": [
                            "rector/rector",
                            "phpstan/phpstan",
                            "phpstan/phpstan-doctrine:>=2.0",
                            "phpstan/phpstan-symfony:>=2.0"
                        ]
                    }
                ]
            },
            "files": {
                "tests/phpstan/console-application.php": {
                    "contents": [
                        "<?php",
                        "",
                        "declare(strict_types=1);",
                        "",
                        "use App\\Kernel;",
                        "use Symfony\\Bundle\\FrameworkBundle\\Console\\Application;",
                        "",
                        "require __DIR__ . '/../bootstrap.php';",
                        "",
                        "$kernel = new Kernel($_SERVER['APP_ENV'], (bool) $_SERVER['APP_DEBUG']); // @phpstan-ignore-line argument.type",
                        "$kernel->boot();",
                        "",
                        "return new Application($kernel);",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "cd7560df65ba07f808d315bfde1c42d29adeef1e"
        }
    }
}
