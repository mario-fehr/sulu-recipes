Reason: (f) The two_factor firewall block and the ^/admin/2fa access rule go into security.yaml only with scheb/2fa-bundle, because Symfony rejects the two_factor option without the bundle.
Evidence: sulu/skeleton config/packages/security.yaml lines 31-37 and 70 at the pin in tests/lines/3.0.env; tests/install-bare.sh checks that security.yaml has no two_factor without the bundle.

--- a/manifest.json
+++ b/manifest.json
@@ -5,5 +5,29 @@
     "copy-from-recipe": {
         "config/": "%CONFIG_DIR%/"
     },
+    "add-lines": [
+        {
+            "file": "%CONFIG_DIR%/packages/security.yaml",
+            "position": "after_target",
+            "target": "path: sulu_admin.logout",
+            "content": [
+                "            two_factor:",
+                "                prepare_on_login: true",
+                "                prepare_on_access_denied: true",
+                "                check_path: 2fa_login_check_admin",
+                "                authentication_required_handler: sulu_security.two_factor_authentication_required_handler",
+                "                success_handler: sulu_security.two_factor_authentication_success_handler",
+                "                failure_handler: sulu_security.two_factor_authentication_failure_handler"
+            ]
+        },
+        {
+            "file": "%CONFIG_DIR%/packages/security.yaml",
+            "position": "after_target",
+            "target": "^/admin/login$",
+            "content": [
+                "        - { path: ^/admin/2fa, roles: PUBLIC_ACCESS }"
+            ]
+        }
+    ],
     "aliases": ["2fa"]
 }
