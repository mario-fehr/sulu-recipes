{
    "bundles": {
        "Sulu\\Bundle\\CoreBundle\\SuluCoreBundle": ["all"],
        "HandcraftedInTheAlps\\RestRoutingBundle\\RestRoutingBundle": ["all"],
        "Massive\\Bundle\\SearchBundle\\MassiveSearchBundle": ["all"],
        "FOS\\HttpCacheBundle\\FOSHttpCacheBundle": ["all"],
        "Sulu\\Bundle\\AdminBundle\\SuluAdminBundle": ["all"],
        "Sulu\\Bundle\\SearchBundle\\SuluSearchBundle": ["all"],
        "Sulu\\Bundle\\PersistenceBundle\\SuluPersistenceBundle": ["all"],
        "Sulu\\Bundle\\ContactBundle\\SuluContactBundle": ["all"],
        "Sulu\\Bundle\\MediaBundle\\SuluMediaBundle": ["all"],
        "Sulu\\Bundle\\SecurityBundle\\SuluSecurityBundle": ["all"],
        "Sulu\\Bundle\\CategoryBundle\\SuluCategoryBundle": ["all"],
        "Sulu\\Bundle\\SnippetBundle\\SuluSnippetBundle": ["all"],
        "Sulu\\Bundle\\PageBundle\\SuluPageBundle": ["all"],
        "Sulu\\Bundle\\TagBundle\\SuluTagBundle": ["all"],
        "Sulu\\Bundle\\WebsiteBundle\\SuluWebsiteBundle": ["all"],
        "Sulu\\Bundle\\LocationBundle\\SuluLocationBundle": ["all"],
        "Sulu\\Bundle\\HttpCacheBundle\\SuluHttpCacheBundle": ["all"],
        "Sulu\\Bundle\\DocumentManagerBundle\\SuluDocumentManagerBundle": ["all"],
        "Sulu\\Bundle\\HashBundle\\SuluHashBundle": ["all"],
        "Sulu\\Bundle\\CustomUrlBundle\\SuluCustomUrlBundle": ["all"],
        "Sulu\\Bundle\\RouteBundle\\SuluRouteBundle": ["all"],
        "Sulu\\Bundle\\MarkupBundle\\SuluMarkupBundle": ["all"],
        "PHPCR\\PhpcrMigrationsBundle\\PhpcrMigrationsBundle": ["all"],
        "Massive\\Bundle\\BuildBundle\\MassiveBuildBundle": ["all"],
        "Sulu\\Bundle\\TestBundle\\SuluTestBundle": ["dev", "test"],
        "Sulu\\Bundle\\PreviewBundle\\SuluPreviewBundle": ["all"],
        "Symfony\\Cmf\\Bundle\\RoutingBundle\\CmfRoutingBundle": ["all", "website"],
        "Sulu\\Bundle\\ActivityBundle\\SuluActivityBundle": ["all"],
        "Sulu\\Bundle\\TrashBundle\\SuluTrashBundle": ["all"],
        "Sulu\\Bundle\\ReferenceBundle\\SuluReferenceBundle": ["all"]
    },
    "copy-from-recipe": {
        ".env.stage": ".env.stage",
        "assets/": "assets/",
        "bin/": "%BIN_DIR%/",
        "config/": "%CONFIG_DIR%/",
        "public/": "%PUBLIC_DIR%/",
        "templates/": "templates/",
        "tests/": "tests/",
        "var/": "%VAR_DIR%/"
    },
    "env": {
        "#1": "Email address that will receive system notifications and might be used as universal fallback value by bundles",
        "SULU_ADMIN_EMAIL": "example@localhost"
    },
    "gitignore": [
        "/%PUBLIC_DIR%/uploads/"
    ]
}
