{
    "manifests": {
        "scheb/2fa-bundle": {
            "manifest": {
                "bundles": {
                    "Scheb\\TwoFactorBundle\\SchebTwoFactorBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "add-lines": [
                    {
                        "file": "%CONFIG_DIR%/packages/security.yaml",
                        "position": "after_target",
                        "target": "path: sulu_admin.logout",
                        "content": "            two_factor:\n                prepare_on_login: true\n                prepare_on_access_denied: true\n                check_path: 2fa_login_check_admin\n                authentication_required_handler: sulu_security.two_factor_authentication_required_handler\n                success_handler: sulu_security.two_factor_authentication_success_handler\n                failure_handler: sulu_security.two_factor_authentication_failure_handler"
                    },
                    {
                        "file": "%CONFIG_DIR%/packages/security.yaml",
                        "position": "after_target",
                        "target": "^/admin/login$",
                        "content": "        - { path: ^/admin/2fa, roles: PUBLIC_ACCESS }"
                    }
                ]
            },
            "files": {
                "config/packages/scheb_2fa.yaml": {
                    "contents": [
                        "# See the configuration reference at https://symfony.com/bundles/SchebTwoFactorBundle/7.x/configuration.html",
                        "scheb_two_factor:",
                        "    security_tokens:",
                        "        - Symfony\\Component\\Security\\Core\\Authentication\\Token\\UsernamePasswordToken",
                        "        - Symfony\\Component\\Security\\Http\\Authenticator\\Token\\PostAuthenticationToken",
                        "    email:",
                        "        enabled: true",
                        "    trusted_device:",
                        "        enabled: true",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/scheb_2fa.yaml": {
                    "contents": [
                        "2fa_login_check_admin:",
                        "    path: /admin/2fa_check",
                        "",
                        "# Activate the following routes to use 2fa on your website application:",
                        "#",
                        "# 2fa_login:",
                        "#     path: /2fa",
                        "#     defaults:",
                        "#         _controller: \"scheb_two_factor.form_controller::form\"",
                        "#",
                        "# 2fa_login_check:",
                        "#     path: /2fa_check",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "dcf35d4e231f7f5b05a88dee9121a50c25e29df9"
        }
    }
}
