{
    "manifests": {
        "scheb/2fa-bundle": {
            "manifest": {
                "bundles": {
                    "Scheb\\TwoFactorBundle\\SchebTwoFactorBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                }
            },
            "files": {
                "config/packages/scheb_2fa.yaml": {
                    "contents": [
                        "# See the configuration reference at https://symfony.com/bundles/SchebTwoFactorBundle/6.x/configuration.html",
                        "scheb_two_factor:",
                        "    security_tokens:",
                        "        - Symfony\\Component\\Security\\Core\\Authentication\\Token\\UsernamePasswordToken",
                        "        - Symfony\\Component\\Security\\Http\\Authenticator\\Token\\PostAuthenticationToken",
                        "    email:",
                        "        enabled: true",
                        "    trusted_device:",
                        "        enabled: true",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/scheb_2fa.yaml": {
                    "contents": [
                        "2fa_login_check_admin:",
                        "    path: /admin/2fa_check",
                        "",
                        "# Activate the following routes to use 2fa on your website application:",
                        "#",
                        "# 2fa_login:",
                        "#     path: /2fa",
                        "#     defaults:",
                        "#         _controller: \"scheb_two_factor.form_controller::form\"",
                        "#",
                        "# 2fa_login_check:",
                        "#     path: /2fa_check",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "93dac5c858c5df129175c68c672a420102f9571d"
        }
    }
}
