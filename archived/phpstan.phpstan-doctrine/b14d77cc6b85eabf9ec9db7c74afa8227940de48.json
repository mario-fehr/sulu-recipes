{
    "manifests": {
        "phpstan/phpstan-doctrine": {
            "manifest": {
                "copy-from-recipe": {
                    "tests/": "tests/"
                },
                "add-lines": [
                    {
                        "file": "phpstan.dist.neon",
                        "position": "after_target",
                        "target": "    level: max",
                        "content": "    doctrine:\n        objectManagerLoader: tests/phpstan/object-manager.php\n    symfony:\n        containerXmlPath: %currentWorkingDirectory%/var/cache/website/dev/App_KernelDevDebugContainer.xml\n        consoleApplicationLoader: tests/phpstan/console-application.php",
                        "requires": [
                            "phpstan/phpstan",
                            "phpstan/phpstan-doctrine:>=2.0",
                            "phpstan/phpstan-symfony:>=2.0",
                            "phpstan/extension-installer"
                        ]
                    },
                    {
                        "file": "rector.php",
                        "position": "after_target",
                        "target": "    ->withRootFiles()",
                        "content": "    ->withPHPStanConfigs([\n        __DIR__ . '/phpstan.dist.neon',\n        // rector does not load phpstan extension automatically so require them manually here:\n        __DIR__ . '/vendor/phpstan/phpstan-doctrine/extension.neon',\n        __DIR__ . '/vendor/phpstan/phpstan-symfony/extension.neon',\n    ])",
                        "requires": [
                            "rector/rector",
                            "phpstan/phpstan",
                            "phpstan/phpstan-doctrine:>=2.0",
                            "phpstan/phpstan-symfony:>=2.0"
                        ]
                    }
                ]
            },
            "files": {
                "tests/phpstan/object-manager.php": {
                    "contents": [
                        "<?php",
                        "",
                        "declare(strict_types=1);",
                        "",
                        "use App\\Kernel;",
                        "use Doctrine\\ORM\\EntityManager;",
                        "use Doctrine\\ORM\\Events;",
                        "use Doctrine\\ORM\\Tools\\ResolveTargetEntityListener;",
                        "use Symfony\\Component\\DependencyInjection\\ContainerInterface;",
                        "",
                        "require __DIR__ . '/../bootstrap.php';",
                        "",
                        "$kernel = new Kernel($_SERVER['APP_ENV'], (bool) $_SERVER['APP_DEBUG']); // @phpstan-ignore-line argument.type",
                        "$kernel->boot();",
                        "",
                        "/** @var ContainerInterface $container */",
                        "$container = $kernel->getContainer();",
                        "",
                        "/** @var EntityManager $objectManager */",
                        "$objectManager = $container->get('doctrine')->getManager();",
                        "",
                        "// remove ResolveTargetEntityListener from returned EntityManager to not resolve SuluPersistenceBundle classes",
                        "// this is a workaround for the following phpstan issue: https://github.com/phpstan/phpstan-doctrine/issues/98",
                        "$resolveTargetEntityListener = \\current(\\array_filter(",
                        "    $objectManager->getEventManager()->getListeners('loadClassMetadata'),",
                        "    static fn ($listener) => $listener instanceof ResolveTargetEntityListener,",
                        "));",
                        "",
                        "if (false !== $resolveTargetEntityListener) {",
                        "    $objectManager->getEventManager()->removeEventListener([Events::loadClassMetadata], $resolveTargetEntityListener);",
                        "}",
                        "",
                        "return $objectManager;",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "b14d77cc6b85eabf9ec9db7c74afa8227940de48"
        }
    }
}
